# 1. Create project directory
mkdir python-hello && cd python-hello

# 2. Create Python program
cat > app.py <<'EOF'
print("Hello World from Python Docker!")
EOF

# 3. Create Dockerfile
cat > Dockerfile <<'EOF'
FROM python:3.12-alpine
WORKDIR /app
COPY app.py .
CMD ["python", "app.py"]
EOF

# 4. Build custom Docker image
docker build -t python-hello .

# 5. Run container
docker run --rm python-hello
